# Sift config — copy to .env and fill in
SIFT_VAULT_PATH=/absolute/path/to/your/ObsidianVault
# State (dedup ledger + LanceDB index) defaults to <vault>/.sift — override only if needed:
# SIFT_WORK_DIR=/somewhere/else/.sift

# Models (provider-swappable; can be local)
SIFT_LLM_PROVIDER=anthropic
SIFT_LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
SIFT_EMBED_PROVIDER=openai
SIFT_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Image OCR backend (DESIGN §17): vlm = provider vision model (default, best on
# stylized/meme content); local = OpenAI-compatible local server — free unlimited,
# image bytes stay on-machine. Local setup: brew install ollama &&
# brew services start ollama && ollama pull frob/unlimited-ocr:q8_0
# SIFT_OCR_BACKEND=local
# SIFT_OCR_BASE_URL=http://localhost:11434/v1
# SIFT_OCR_MODEL=frob/unlimited-ocr:q8_0

# Ingestion (fetch cadence is enforced in code — weekly default, never hourly; CLAUDE.md rule 1)
SIFT_COOKIE_BROWSER=chrome
# Your own Instagram username — cookie_fetch pulls https://www.instagram.com/<you>/saved/
SIFT_IG_USERNAME=
