# Sift config — copy to .env and fill in
SIFT_VAULT_PATH=/absolute/path/to/your/ObsidianVault
# State (dedup ledger + LanceDB index) defaults to <vault>/.sift — override only if needed:
# SIFT_WORK_DIR=/somewhere/else/.sift

# Models (provider-swappable; can be local)
SIFT_LLM_PROVIDER=anthropic
SIFT_LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# OR route the interpreter through any OpenAI-compatible /v1 gateway (e.g. a
# local Claude Code wrapper) instead of the Anthropic API; no real key needed
# (SIFT_LLM_API_KEY overrides the placeholder if your gateway wants one):
# SIFT_LLM_BASE_URL=http://127.0.0.1:47821/v1
# SIFT_LLM_MODEL=claude-haiku-4-5-20251001
SIFT_EMBED_PROVIDER=openai
SIFT_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Fully-local search embeddings (F5; needs `pip install 'sift[rag]'`): point the
# embedder at Ollama's OpenAI-compatible endpoint — nothing leaves the machine.
# Setup: ollama pull nomic-embed-text
# SIFT_EMBED_BASE_URL=http://localhost:11434/v1
# SIFT_EMBED_MODEL=nomic-embed-text
# SIFT_EMBED_DIMENSIONS=768

# Image OCR backend (DESIGN §17): vlm = provider vision model (default, best on
# stylized/meme content); local = OpenAI-compatible local server — free unlimited,
# image bytes stay on-machine. Local setup: brew install ollama &&
# brew services start ollama && ollama pull frob/unlimited-ocr:q8_0
# SIFT_OCR_BACKEND=local
# SIFT_OCR_BASE_URL=http://localhost:11434/v1
# SIFT_OCR_MODEL=frob/unlimited-ocr:q8_0

# Reels/video STT (F4; needs `pip install 'sift[stt]'`). Local faster-whisper model;
# translation is X->English only (Whisper's only direction) and off by default.
# SIFT_STT_MODEL=small
# SIFT_STT_TRANSLATE_TO_ENGLISH=false

# share_capture endpoint (F7; docs/share-capture.md). REQUIRED for `sift serve` on a
# non-loopback host (the phone path). Generate: openssl rand -hex 16
# SIFT_CAPTURE_TOKEN=

# Ingestion (fetch cadence is enforced in code — weekly default, never hourly; CLAUDE.md rule 1)
SIFT_COOKIE_BROWSER=chrome
# Your own Instagram username — cookie_fetch pulls https://www.instagram.com/<you>/saved/.
SIFT_IG_USERNAME=
# dm_fetch opens your note-to-self thread by its stable DIRECT URL (the inbox list is
# virtualized + click-walled, so the thread id is the reliable handle). Open that chat on
# instagram.com/direct/ and copy the address bar. Required for `sift run --source dm_fetch`;
# run `sift dm-login` once to seed the dedicated profile ([dm_fetch] extra + `playwright
# install chromium`).
SIFT_DM_THREAD_URL=
# dm_fetch's browser profile holds a LIVE Instagram session (cookies). It defaults to an OS
# state dir OUTSIDE the vault (a cloud-synced vault must never carry your session); override
# only to another NON-synced path.
# SIFT_DM_PROFILE_DIR=/absolute/path/outside/synced/folders/sift-dm-profile

# Media backfill. Bulk imports (DYI export) carry permalinks but no media bytes.
# With SIFT_MEDIA_DEFER=true, Instagram items without media wait in a SQLite queue
# (<work_dir>/ledger.db, media_queue table) instead of getting caption-only analysis;
# `sift fetch-media` drains the queue in even, daily-schedulable chunks and runs the
# ONE full analysis per item (OCR/STT included). Audit progress any time:
#   sqlite3 <work_dir>/ledger.db "SELECT status, COUNT(*) FROM media_queue GROUP BY status"
# SIFT_MEDIA_DEFER=true
# SIFT_MEDIA_CHUNK_SIZE=100

# Graph layer (connected second brain). merge_similarity: token-overlap floor for
# folding a re-saved duplicate into its existing page (skips its model call);
# link_max: Related wikilinks per note (Obsidian graph edges). Topic hub pages
# (Topics/<tag>.md) are always generated from note tags.
# SIFT_MERGE_SIMILARITY=0.85
# SIFT_LINK_MAX=4
