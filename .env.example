# Sift config — copy to .env and fill in
SIFT_VAULT_PATH=/absolute/path/to/your/ObsidianVault
# State (SQLite + LanceDB + dedup ledger) defaults to <vault>/.sift — override only if needed:
# SIFT_WORK_DIR=/somewhere/else/.sift
# SIFT_DB_URL=sqlite:////custom/path/sift.db

# Models (provider-swappable; can be local)
SIFT_LLM_PROVIDER=anthropic
SIFT_LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
SIFT_EMBED_PROVIDER=openai
SIFT_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Ingestion
SIFT_COOKIE_BROWSER=chrome
SIFT_FETCH_CADENCE=weekly   # weekly (default) | daily (ceiling). NEVER hourly.

# Deferred features stay off (no instagrapi flag — it is banned outright, CLAUDE.md rule 1)
SIFT_ENABLE_FRAME_OCR=false
SIFT_ENABLE_TRANSLATION=false
