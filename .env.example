# Sift config — copy to .env and fill in
SIFT_VAULT_PATH=/absolute/path/to/your/ObsidianVault
# State (dedup ledger + LanceDB index) defaults to <vault>/.sift — override only if needed:
# SIFT_WORK_DIR=/somewhere/else/.sift

# Models (provider-swappable; can be local)
SIFT_LLM_PROVIDER=anthropic
SIFT_LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
SIFT_EMBED_PROVIDER=openai
SIFT_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Ingestion (fetch cadence is enforced in code — weekly default, never hourly; CLAUDE.md rule 1)
SIFT_COOKIE_BROWSER=chrome
